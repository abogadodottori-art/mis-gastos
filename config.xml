<?xml version='1.0' encoding='utf-8'?>
<widget id="com.tudominio.gastosapp" version="1.1.0" xmlns="http://www.w3.org/ns/widgets" xmlns:cdv="http://cordova.apache.org/ns/1.0">
    <name>Mis Gastos</name>
    <description>App para gestionar gastos mensuales de forma rapida y offline.</description>
    <author email="dev@tudominio.com" href="https://tudominio.com">Tu Nombre</author>
    <content src="index.html" />

    <access origin="https://localhost" />
    <access origin="file:///*" />
    <allow-navigation href="blob:*" />
    <allow-intent href="market:*" />

    <platform name="android">
        <allow-intent href="market:*" />
    </platform>

    <preference name="DisallowOverscroll" value="true" />
    <preference name="BackgroundColor" value="0xFF0F172A" />
    <preference name="StatusBarOverlaysWebView" value="false" />
    <preference name="StatusBarBackgroundColor" value="#0F172A" />
    <preference name="StatusBarStyle" value="lightcontent" />
    <preference name="Orientation" value="portrait" />
    <preference name="Fullscreen" value="false" />
    <preference name="android-minSdkVersion" value="22" />
    <preference name="android-targetSdkVersion" value="33" />
    <preference name="android-compileSdkVersion" value="33" />

    <plugin name="cordova-plugin-statusbar" spec="^2.4.3" />
    <plugin name="cordova-plugin-file" spec="^8.1.0" />
    <plugin name="cordova-plugin-file-opener2" spec="^4.0.0" />
</widget>
